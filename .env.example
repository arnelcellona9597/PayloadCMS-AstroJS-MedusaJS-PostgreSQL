# ─────────────────────────────────────────────────────────────────────────────
# Reference values for the whole stack.
#
# Each app reads its OWN .env file (apps/cms/.env, apps/commerce/.env,
# apps/storefront/.env). This file is the single place to see how they line up.
# `npm run setup` writes all three from these values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Shared database server (infra/docker-compose.yml) ────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── apps/cms — Payload 3 + Next 16 → http://localhost:3000 ──────────────────
# Payload calls this DATABASE_URI (Medusa calls its equivalent DATABASE_URL).
DATABASE_URI=postgres://postgres:postgres@localhost:5433/payload_crud
PAYLOAD_SECRET=dev-only-payload-secret-change-me
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── apps/commerce — Medusa 2 → http://localhost:9000 (admin at /app) ────────
DATABASE_URL=postgres://postgres:postgres@localhost:5433/medusa_crud
JWT_SECRET=dev-only-jwt-secret-change-me
COOKIE_SECRET=dev-only-cookie-secret-change-me
# Medusa rejects browser requests from origins not listed here.
STORE_CORS=http://localhost:4321
ADMIN_CORS=http://localhost:9000,http://localhost:4321
AUTH_CORS=http://localhost:9000,http://localhost:4321
MEDUSA_ADMIN_EMAIL=admin@local.test
MEDUSA_ADMIN_PASSWORD=supersecret

# ── apps/storefront — Astro 7 → http://localhost:4321 ───────────────────────
PAYLOAD_URL=http://localhost:3000
MEDUSA_URL=http://localhost:9000

# Both of these are created by the seed/bootstrap scripts and printed to the
# terminal. `npm run setup` writes them into apps/storefront/.env for you.
#
#   PAYLOAD_API_KEY        → sent as `Authorization: users API-Key <key>`
#   MEDUSA_PUBLISHABLE_KEY → sent as `x-publishable-api-key: <key>`
#                            REQUIRED on every /store/* call, including the
#                            custom ones. Omit it and Medusa returns 400.
PAYLOAD_API_KEY=
MEDUSA_PUBLISHABLE_KEY=

# Note the absence of a PUBLIC_/NEXT_PUBLIC_ prefix on the keys above: Astro
# only exposes PUBLIC_-prefixed vars to the browser. These are secrets, and
# because every page is server-rendered the browser never needs them.
