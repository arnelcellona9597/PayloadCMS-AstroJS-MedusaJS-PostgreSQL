# ── Database ────────────────────────────────────────────────────────────────
# Medusa calls this DATABASE_URL. Payload's equivalent is DATABASE_URL too, but
# it points at a DIFFERENT database — the two backends never share tables.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/medusa_crud

# ── Secrets ─────────────────────────────────────────────────────────────────
JWT_SECRET=dev-only-jwt-secret-change-me
COOKIE_SECRET=dev-only-cookie-secret-change-me

# ── CORS ────────────────────────────────────────────────────────────────────
# Which browser origins may call each surface. The Astro storefront talks to
# Medusa from the SERVER, so it does not strictly need to be listed here — but
# it is, so that browser-side experiments work without head-scratching.
STORE_CORS=http://localhost:4321
ADMIN_CORS=http://localhost:9000,http://localhost:4321
AUTH_CORS=http://localhost:9000,http://localhost:4321

# ── Local admin credentials (created by `npm run bootstrap`) ────────────────
MEDUSA_ADMIN_EMAIL=admin@local.test
MEDUSA_ADMIN_PASSWORD=supersecret

# ── Teaching flag ───────────────────────────────────────────────────────────
# Set to 1 to make the "link review to product" workflow step throw on purpose.
# Use it to watch the whole create-review workflow roll back. See
# src/workflows/steps/link-review-to-product.ts
DEMO_FAIL_LINK_STEP=0

# ── Rate limiting (src/api/rate-limit.ts, wired in src/api/middlewares.ts) ──
# Applies to /store/* only. /admin/* is deliberately unlimited: those routes
# already require an authenticated admin, and rate-limiting your own moderators
# out of the dashboard is a self-inflicted outage.
#
# Keyed by publishable API key when present, falling back to IP.
RATE_LIMIT_STORE_MAX=240
RATE_LIMIT_WINDOW_MS=60000

# ── Redis (infra/docker-compose.yml) ────────────────────────────────────────
# Backs the cache, event bus, workflow engine and locking. Remove this and
# Medusa falls back to in-memory equivalents — which work for one process and
# break for two. The workflow engine in particular stops persisting executions,
# so workflow_execution stays empty. See docs/learn/12-operating-it.md.
REDIS_URL=redis://localhost:6379

# ── Uptime monitoring targets (src/jobs/uptime-check.ts) ────────────────────
PAYLOAD_URL=http://localhost:3000
MEDUSA_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:4321
