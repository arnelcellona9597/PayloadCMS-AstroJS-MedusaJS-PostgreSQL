# ── Backends ────────────────────────────────────────────────────────────────
PAYLOAD_URL=http://localhost:3000
MEDUSA_URL=http://localhost:9000

# ── Credentials ─────────────────────────────────────────────────────────────
# NOT prefixed with PUBLIC_, on purpose.
#
# Astro only exposes PUBLIC_-prefixed variables to client-side code. Because every
# page here renders on the server, the browser never needs these values — so they
# stay server-only. This is the concrete payoff of the BFF pattern.
#
#   PAYLOAD_API_KEY        → printed by `npm run seed`      in apps/cms
#   MEDUSA_PUBLISHABLE_KEY → printed by `npm run bootstrap` in apps/commerce
PAYLOAD_API_KEY=REPLACE_ME
MEDUSA_PUBLISHABLE_KEY=REPLACE_ME

# Admin credentials, used to obtain a JWT for moderation calls to /admin/*.
MEDUSA_ADMIN_EMAIL=admin@local.test
MEDUSA_ADMIN_PASSWORD=supersecret

# ── Rate limiting (src/middleware.ts) ───────────────────────────────────────
# Applies to /api/* and Astro Action submissions only — plain page views are
# never limited. Counters are in-memory, so they reset on restart and do NOT
# work across multiple instances. See docs/learn/09-to-production.md.
#
# Lower RATE_LIMIT_MAX to something small (e.g. 5) to see a 429 for yourself.
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
