---
import { actions, isInputError } from 'astro:actions'

import Layout from '../../layouts/Layout.astro'
import { imageUrl } from '../../lib/types'
import { listPosts, listCategories } from '../../lib/payload'

export const prerender = false

/**
 * Posts list — READ and DELETE.
 *
 * ── How an Action result reaches this page ─────────────────────────────────
 * The delete form below posts to `actions.post.delete`. Astro runs the handler,
 * then re-renders THIS page with the result retrievable via
 * `Astro.getActionResult(...)`. No client-side JavaScript is involved, which is
 * why the delete button works with JS switched off.
 *
 * `includeDrafts: true` sends the API key, so drafts appear. Reload
 * http://localhost:3000/api/posts in a browser (no key) and the draft is missing
 * — same data, different access rules.
 */
const deleteResult = Astro.getActionResult(actions.post.delete)

/**
 * Filtering and paging are read from the QUERY STRING and applied on the
 * server, so both work with JavaScript disabled and every view is a URL you can
 * share. Same approach as /monitor.
 *
 * ⚠️ Without this the page fetched a flat `limit: 50`. At 88 guides that
 * silently hid 38 of them while still printing the true total — a truncated
 * list with an accurate count, which is worse than either alternative because
 * nothing looks wrong.
 */
const PER_PAGE = 20

const url = Astro.url
const page = Math.max(1, Number(url.searchParams.get('page') ?? 1) || 1)
const categoryParam = url.searchParams.get('category')
const categoryId = categoryParam ? Number(categoryParam) || undefined : undefined

/**
 * Two orderings, and the default is the teaching one.
 *
 * `order` is an explicit curriculum position on the collection, so guide 1 is
 * genuinely the first thing to read. This page used to sort `-publishedAt`,
 * which made the seed's array order the reading order by accident — and
 * backwards, so the archive opened on server hardening and buried "what to
 * install" ninety guides down.
 *
 * ⚠️ `order` is nullable: a post created in the admin panel has no curriculum
 * position. Postgres sorts NULLs last on an ascending sort, so those land after
 * the path rather than silently in front of it.
 */
const sortMode = url.searchParams.get('sort') === 'new' ? 'new' : 'path'
const sort = sortMode === 'new' ? '-publishedAt' : 'order'

const [{ docs: categories }, result] = await Promise.all([
  listCategories(),
  listPosts({
    limit: PER_PAGE,
    page,
    depth: 1,
    includeDrafts: true,
    sort,
    categoryId,
  }),
])

const { docs: posts, totalDocs, totalPages, hasPrevPage, hasNextPage } = result

/** Preserve the other parameter when switching one of them. */
const href = (next: { page?: number; category?: number | 'all'; sort?: 'path' | 'new' }) => {
  const q = new URLSearchParams()
  const cat = next.category === undefined ? categoryId : next.category === 'all' ? undefined : next.category
  if (cat !== undefined) q.set('category', String(cat))
  if (next.page !== undefined && next.page > 1) q.set('page', String(next.page))
  const s = next.sort ?? sortMode
  if (s === 'new') q.set('sort', 'new')
  const qs = q.toString()
  return qs ? `/posts?${qs}` : '/posts'
}

const activeCategory = categories.find((c) => c.id === categoryId)

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
---

<Layout
  title="Posts"
  subtitle="Payload owns these. CRUD runs through Astro Actions — see src/actions/index.ts."
  section="posts"
>
  {
    deleteResult && !deleteResult.error && (
      <div class="notice success">
        <p>Post {deleteResult.data.id} deleted.</p>
      </div>
    )
  }
  {
    deleteResult?.error && (
      <div class="notice error">
        <p>
          Could not delete: {deleteResult.error.message}
          {isInputError(deleteResult.error) && ' (invalid input)'}
        </p>
      </div>
    )
  }

  <div class="row between" style="margin-bottom:14px">
    <p class="muted small" style="margin:0">
      {totalDocs} {activeCategory ? `posts in ${activeCategory.name}` : 'posts'}, drafts included (this page sends the
      API key).{totalPages > 1 && ` Page ${page} of ${totalPages}.`}
    </p>
    <a class="btn primary" href="/posts/new">New post</a>
  </div>

  <div class="row filters">
    <a class:list={['btn', 'small', { active: categoryId === undefined }]} href={href({ category: 'all', page: 1 })}>
      All
    </a>
    {
      categories.map((category) => (
        <a
          class:list={['btn', 'small', { active: categoryId === category.id }]}
          href={href({ category: category.id, page: 1 })}
        >
          {category.name}
        </a>
      ))
    }
  </div>

  <div class="row between sortbar">
    <p class="small muted" style="margin:0">
      {
        sortMode === 'path'
          ? 'Sorted by reading order — start at the top and work down.'
          : 'Sorted newest first, which is the reverse of the reading order.'
      }
    </p>
    <div class="row" style="gap:6px">
      <a class:list={['btn', 'small', { active: sortMode === 'path' }]} href={href({ sort: 'path', page: 1 })}>
        Learning path
      </a>
      <a class:list={['btn', 'small', { active: sortMode === 'new' }]} href={href({ sort: 'new', page: 1 })}>
        Newest first
      </a>
    </div>
  </div>

  {
    posts.length === 0 ? (
      <div class="notice info">
        <p>
          No posts yet. Run <code class="path">npm run seed</code> in <code class="path">apps/cms</code>, or create one
          above.
        </p>
      </div>
    ) : (
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th style="width:1%">#</th>
              <th>Title</th>
              <th>Category</th>
              <th>Status</th>
              <th>Updated</th>
              <th style="text-align:right">Actions</th>
            </tr>
          </thead>
          <tbody>
            {posts.map((post) => (
              <tr>
                <td class="step-cell">
                  {post.order ? <span class="step">{post.order}</span> : <span class="muted small">—</span>}
                </td>
                <td>
                  <div class="title-cell">
                    {/* depth:1 on the list query is what makes this a URL rather than an id. */}
                    {imageUrl(post.coverImage, 'thumbnail') && (
                      <img
                        class="thumb"
                        src={imageUrl(post.coverImage, 'thumbnail')}
                        alt=""
                        width="80"
                        height="45"
                        loading="lazy"
                      />
                    )}
                    <div>
                      <strong>{post.title}</strong>
                      <div class="small muted mono">/{post.slug}</div>
                      {post.excerpt && <div class="small muted">{post.excerpt}</div>}
                    </div>
                  </div>
                </td>
                <td class="small">
                  {post.category && typeof post.category === 'object' ? post.category.name : <span class="muted">—</span>}
                </td>
                <td>
                  <span class:list={['badge', post._status ?? 'draft']}>{post._status ?? 'draft'}</span>
                </td>
                <td class="small muted">{fmt(post.updatedAt)}</td>
                <td class="actions-cell">
                  <div class="actions">
                    {post._status === 'published' && (
                      <a class="btn small" href={`/posts/${post.slug}`}>
                        View
                      </a>
                    )}
                    <a class="btn small" href={`/posts/${post.id}/edit`}>
                      Edit
                    </a>
                    {/*
                      A form, not a link — HTML forms can only GET or POST, and a
                      GET link would let a crawler delete the post. The Action is
                      what makes this both safe and typed.
                    */}
                    <form method="POST" action={actions.post.delete} style="display:inline">
                      <input type="hidden" name="id" value={post.id} />
                      <button class="btn small danger" type="submit">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  {
    totalPages > 1 && (
      <nav class="row between pager">
        {hasPrevPage ? (
          <a class="btn small" href={href({ page: page - 1 })}>
            ← Previous
          </a>
        ) : (
          <span class="btn small disabled">← Previous</span>
        )}
        <span class="small muted">
          Page {page} of {totalPages}
        </span>
        {hasNextPage ? (
          <a class="btn small" href={href({ page: page + 1 })}>
            Next →
          </a>
        ) : (
          <span class="btn small disabled">Next →</span>
        )}
      </nav>
    )
  }

  <div class="card" style="margin-top:28px">
    <h3>What just happened</h3>
    <p class="small muted" style="margin-bottom:8px">
      Every row above came from one request in this page's frontmatter:
    </p>
    <p class="mono small">
      GET http://localhost:3000/api/posts?limit={PER_PAGE}&page={page}&depth=1&sort={sort}<br />
      Authorization: users API-Key ••••••••
    </p>
    <p class="small muted" style="margin-bottom:0">
      Payload generated that endpoint from <code class="path">apps/cms/src/collections/Posts.ts</code>. No controller was
      written on either side.
    </p>
  </div>
</Layout>

<style>
  .title-cell {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  /* Fixed box so rows keep the same height whether or not a post has a cover. */
  .thumb {
    flex: 0 0 auto;
    width: 80px;
    height: 45px;
    object-fit: cover;
    border-radius: 4px;
    border: 1px solid var(--border);
  }

  .filters {
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }

  .btn.active {
    background: var(--accent);
    color: var(--surface);
    border-color: var(--accent);
  }

  .btn.disabled {
    opacity: 0.4;
    cursor: default;
  }

  .sortbar {
    margin: 10px 0 16px;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .step-cell {
    text-align: right;
    vertical-align: top;
    padding-top: 14px;
  }
  /* Tabular numerals so the column stays a straight edge from 1 to 103. */
  .step {
    font-family: var(--mono, ui-monospace, monospace);
    font-variant-numeric: tabular-nums;
    font-size: 12px;
    color: var(--muted, #8a8372);
  }
  .pager {
    margin-top: 22px;
    align-items: center;
  }
</style>
