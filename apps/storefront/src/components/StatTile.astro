---
/**
 * A single number, stated plainly.
 *
 * Deliberately not a chart. One value over no time dimension has no shape to
 * plot — a sparkline here would be decoration, and a donut of one number is the
 * classic dashboard anti-pattern. The number IS the visualisation.
 *
 * `tone` uses the layout's status tokens, and is always paired with visible
 * text (the note, or the label) so state is never carried by colour alone.
 */
interface Props {
  label: string
  value: string | number
  note?: string
  tone?: 'neutral' | 'ok' | 'warn' | 'down'
  href?: string
}

const { label, value, note, tone = 'neutral', href } = Astro.props
const Tag = href ? 'a' : 'div'
---

<Tag class:list={['tile', tone, { linked: Boolean(href) }]} href={href}>
  <span class="tile-label">{label}</span>
  <span class="tile-value">{value}</span>
  {note && <span class="tile-note">{note}</span>}
</Tag>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    /* A left rule encodes state redundantly with the note text. */
    border-left-width: 3px;
    border-left-style: solid;
    border-left-color: var(--border);
  }

  .tile.ok   { border-left-color: var(--green); }
  .tile.warn { border-left-color: var(--amber); }
  .tile.down { border-left-color: var(--red); }

  .tile.linked:hover { background: var(--surface-2); }

  .tile-label {
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .tile-value {
    font-size: 26px;
    font-weight: 600;
    line-height: 1.1;
    /* Digits line up across a row of tiles. */
    font-variant-numeric: tabular-nums;
  }

  .tile-note {
    font-size: 12px;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .tile.ok   .tile-note { color: var(--green); }
  .tile.warn .tile-note { color: var(--amber); }
  .tile.down .tile-note { color: var(--red); }
</style>
