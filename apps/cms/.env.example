# Payload reads plain env vars in src/payload.config.ts — there is no magic
# naming convention here beyond what the config file references.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/payload_crud
PAYLOAD_SECRET=dev-only-payload-secret-change-me
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Origins allowed to call the REST/GraphQL API from a browser.
PAYLOAD_CORS_ORIGINS=http://localhost:4321
